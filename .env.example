PORT=3005
API_KEY=sua_api_key_aqui
# Abre o dashboard automaticamente no navegador ao iniciar (true/false)
OPEN_UI=true

# Diretório do perfil persistente do navegador (sessão do DeepSeek).
# No Docker/volume, use /app/deepseek_profile. Se vazio, usa deepseek_profile/ local.
DEEPSEEK_PROFILE_DIR=

# --- Backend (provider) ---
# deepseek (padrão, via Playwright), qwen (via Playwright) ou local (Ollama / LM Studio)
PROVIDER=deepseek

# Quando PROVIDER=local:
# - Ollama:     http://localhost:11434/v1
# - LM Studio:  http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
# API key do servidor local (opcional; Ollama/LM Studio normalmente não exigem)
LLM_API_KEY=
# Modelo padrão a usar (opcional). Se vazio, usa o modelo enviado pelo cliente.
LLM_MODEL=

# --- Qwen (chat.qwen.ai) ---
# Credenciais opcionais para login automático no Qwen ao iniciar. Se vazias,
# use o botão "Fazer login" do dashboard (abre o navegador para autenticar).
QWEN_EMAIL=
QWEN_PASSWORD=
# Diretório do perfil persistente do navegador (sessão do Qwen). Se vazio,
# usa qwen_profile/ local.
QWEN_PROFILE_DIR=
